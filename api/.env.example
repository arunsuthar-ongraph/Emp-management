DATABASE_URL="postgresql://hrms:hrms@localhost:5433/hrms?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
PORT=3000

# Email notifications. Local dev uses Mailpit (inbox at http://localhost:8025).
# Production: your SMTP provider (SES, SendGrid, Gmail Workspace, etc.). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PeopleDesk HRMS <no-reply@peopledesk.local>"
# Company domain for subdomain addresses (<company>.ROOT_DOMAIN). Production: only with your own domain + wildcard;
# leave unset on Railway's generated domain, where companies use https://<app>.up.railway.app/<company>
ROOT_DOMAIN=localhost
# Link format in emails; {slug} is the company. Subdomain style: https://{slug}.peopledesk.in
# Path style (e.g. Railway generated domain): https://hrms-production.up.railway.app/{slug}. Optional in production.
APP_URL=http://{slug}.localhost:5173

# ---- Production (Railway) ----
# NODE_ENV=production
# JWT_SECRET: at least 32 random characters, e.g. `openssl rand -hex 32` (the app refuses to start without it in production)
# First super admin on an empty database (created once at startup; remove the password afterwards)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Uploaded profile pictures: point at a Railway Volume, e.g. /data/uploads (container disk is wiped on deploy)
UPLOAD_DIR=
